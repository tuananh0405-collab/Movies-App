<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/graph_list"
    app:startDestination="@id/listFragment">

    <fragment
        android:id="@+id/listFragment"
        android:name="com.example.anhvt86_3.presentation.fragments.ListFragment"
        android:label="List Movies"
        tools:layout="@layout/fragment_list" >
        <action
            android:id="@+id/action_listFragment_to_detailFragment2"
            app:destination="@id/detailFragment" />
        <argument
            android:name="movieId"
            app:argType="integer" />
        <argument
            android:name="isFavorite"
            app:argType="boolean" />
    </fragment>
    <fragment
        android:id="@+id/detailFragment"
        android:name="com.example.anhvt86_3.presentation.fragments.DetailFragment"
        android:label="Movie Detail"
        tools:layout="@layout/fragment_detail" />
    <fragment
        android:id="@+id/profileFragment"
        android:name="com.example.anhvt86_3.presentation.fragments.ProfileFragment"
        android:label="User Profile"
        tools:layout="@layout/fragment_profile" />
    <fragment
        android:id="@+id/reminderFragment"
        android:name="com.example.anhvt86_3.presentation.fragments.ReminderFragment"
        android:label="Reminders"
        tools:layout="@layout/fragment_reminder" >
        <action
            android:id="@+id/action_reminderFragment_to_detailFragment"
            app:destination="@id/detailFragment" />
        <argument
            android:name="movieId"
            app:argType="integer" />
        <argument
            android:name="isFavorite"
            app:argType="boolean" />
    </fragment>
</navigation>